<?xml version="1.0" encoding="UTF-8" ?>
<templates>
   <t t-name="quiz_idle_timer.QuizDashboard">
       <div>
            <h1 style="margin:20px; text-align:center; color:#123173;">Start The Quiz!</h1>
            <h2 class="idle_time" style="margin:20px; text-align:center; color:#EE4B2B;">start</h2>
           <div class="mt-5">
               <center>
                   <h1><span><t t-out="CurrentQuestion?.id"/></span>: <t t-out="CurrentQuestion?.question"/></h1>
                   <div  style="margin:30px;">
                       <t t-if="CurrentQuestion?.answer">
                       <t t-foreach="CurrentQuestion?.answer" t-as="answer" t-key="answer_index">
                           <div class="d-flex" style="border:2px solid #30207a; width:250px; border-radius:5px;">
                               <div class="col-10" style="background:#f3e1f7;">
                                    <h4 class="options_answer" ><t t-esc="answer"/></h4>
                               </div>

                               <div class="col-2" style="align-items:center;background:#f3e1f7;">
                                    <input style="" name="answer" t-att-checked="checked=false" t-on-change="CheckingAnswer" type="radio"/>
                               </div>

                           </div>

                          <br/>
                   </t>
                       </t>
                   </div>
                 <div class="d-flex align-items-center justify-content-center">
                     <button class="btn btn-primary" style=" margin:4px;" t-on-click="PrevQuetion">Prev</button>
                     <button class="btn btn-primary" style=" margin:4px;" t-on-click="NextQuestion">Next</button>

                 </div>
               </center>
           </div>
       </div>
   </t>
</templates>