<odoo>
    <data>


     <!--category-->
    <record id="payslips_in_my_account_category" model="ir.module.category">
        <field name="name">payslip in my account</field>
        <field name="description">payslip in my account access right security</field>
    </record>

    <!--privilege -->
    <record id="privilege_access" model="res.groups.privilege">
        <field name="name">payslip in my account privilege access control</field>
        <field name="category_id" ref="payslips_in_my_account_category"/>
    </record>

    <!-- defines groups-->
    <record  model="res.groups" id="group_payslip_user">
        <field name="name">Payslip_user</field>
        <field name="privilege_id" ref="privilege_access"/>
    </record>

    <record  model="res.groups" id="group_payslip_hr">
        <field name="name">HR Manager</field>
        <field name="privilege_id" ref="privilege_access"/>
         <field name="implied_ids" eval="[(4, ref('group_payslip_user'))]"/>


    </record>


</data>


</odoo>