<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="user_payslip_portal_template" inherit_id="portal.portal_my_home" name="user portal">
        <xpath expr="//div[hasclass('o_portal_docs')]">

             <div id="portal_client_category" position="inside">
                 <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/web/static/img/rfq.svg'"/>
                    <t t-set="text">Follow your Payslips</t>
                    <t t-set="title">Payslips</t>
                    <t t-set="url" t-value="'/user_payslips/'"/>
                     <t t-set="config_card" t-value="True"/>
                    <t t-set="placeholder_count" t-value="'purchase_count'"/>
                </t>
            </div>
        </xpath>

    </template>
</odoo>