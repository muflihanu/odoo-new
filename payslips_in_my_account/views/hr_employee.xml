<odoo>
    <record id="hr_employee_form" model="ir.ui.view">
        <field name="name">hr.employee</field>
        <field name="model">hr.employee</field>
         <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button string="Payslip"  type="object" name="playslip_in_my_account"/>
            </xpath>

            <xpath expr="//sheet" position="inside">
                  <div name="button_box" position="inside">
                        <button class="oe_start_button" type="object" icon="oi-subtitle"
                        name="get_payslip_record" string="payslip">
                        </button>
                      </div>
            </xpath>
            <xpath expr="//field[@name='structure_type_id']" position="after">
                    <field name="salary_structure_id"/>

            </xpath>
        </field>
    </record>
</odoo>