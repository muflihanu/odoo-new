<odoo>
    <record id="employee_mail_action" model="ir.actions.act_window">
         <field name="name">Employee Mail </field>
        <field name="res_model">employee.mails</field>
        <field name="view_mode">list,form</field>
    </record>


    <record id="employee_mail_view_form" model="ir.ui.view">
        <field name="name">Employee Mail</field>
        <field name="model">employee.mails</field>
        <field name="arch" type="xml">
            <form string="employee mails form">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                          <h1> <field name="name"/></h1>
                         <newline/>
                         <group>
                             <field name="payslip_name"/>
                             <field name="payslip_id" invisible="1"/>
                             <field name="from_date"/>
                             <field name="to_date"/>
                         </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>




     <record id="employee_mail_view_list" model="ir.ui.view">
        <field name="name">Employee Mail</field>
        <field name="model">employee.mails</field>
        <field name="arch" type="xml">
            <list>
                 <field name="name"/>
                <field name="payslip_name"/>
                <field name="from_date"/>
                <field name="to_date"/>

            </list>
        </field>
    </record>
</odoo>