<odoo>
     <template id="payslips_template" name="user payslips">
           <t t-call="portal.portal_layout">
               <t t-set="is_portal" t-value="True"/>
               <div id="wrap" class="o_portal_wrap">
                   <section>
                   <div class="container">
                       <div class="row">
                            <h1 class="text-center text-primary mt-5">Your Payslips</h1>
                           <div class="col-12 text-centermt-5 o_portal">
                               <table class="table">
                                   <tr>
                                       <th>Name</th>
                                       <th>From</th>
                                       <th>To</th>
                                       <th>Link</th>
                                   </tr>
                         <t t-foreach="values" t-as="val" t-key="val_id">
                                   <tr>

                                           <td><t t-esc="val['name']"/></td>
                                            <td><t t-esc="val['from']"/></td>
                                            <td><t t-esc="val['to']"/></td>
                                            <td> <a t-attf-href="/payslip_details/{{val['payslip_id']}}" class="btn btn-primary">Details</a></td>
                                   </tr>
                                    </t>
                               </table>
                           </div>

                       </div>
                   </div>
                   </section>
               </div>
           </t>

       </template>
</odoo>