<odoo>
     <record id="custom_payslip_line_action" model="ir.actions.act_window">
        <field name="name">Custom Payslip line</field>
        <field name="res_model">custom.payslip.line</field>
        <field name="view_mode">list,form</field>
    </record>


     <record id="custom_payslip_line_view_form" model="ir.ui.view">
        <field name="name">Custom Payslip line</field>
        <field name="model">custom.payslip.line</field>
        <field name="arch" type="xml">
            <form string="custom payslip line form" >
                <sheet>
                    <group>
                         <group>
                             <field name="name"/>
<!--                             <field name="days"/>-->
                             <field name="amount"/>
                             <field name="total_working_hours"/>

                         </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>