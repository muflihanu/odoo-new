<odoo>

        <template id="payslips_details_template" name="page">
           <t t-call="portal.portal_layout">
                <t t-set="is_portal" t-value="True"/>
               <div id="wrap" class="o_portal_wrap">
                   <div class="container">
                       <div class="row d-flex">
                           <h1 class="text-center text-primary">Payslip</h1>
                           <div class="col-12 text-center mt-5 o_portal d-flex">
                                <t t-foreach="vals" t-as="val" t-key="val_id">
                               <div class=" o_portal details_div  w-50" style="border-radius:2px;">

                                        <div class=" col-12 bg-primary p-2" style=" margin-top:15px;">
                                            <h3 class="text-center" style="color:#ffff;"><t t-esc="val['employee']"/></h3>
                                            <h6 class="text-center"  style="color:#ffff;">Name: <t class="sequence_number" t-esc="val['number']"/></h6>
                                        <h6 class="text-center" style="color:#ffff;">Record: <t t-esc="val['emp_record']"/></h6>
                                              <h6 style="margin-right:17px; color:#ffff;">From: <t t-esc="val['from']"/></h6>
                                        <h6 style="margin-right:35px; color:#ffff;">To: <t t-esc="val['to']"/></h6>
                                        <h6 style="margin-right:55px; color:#ffff;">Wage: <t t-esc="val['wage']"/></h6>
                                        </div>
                                    <div class="col-12" style="height:100px;">
                                        <a t-attf-href="/payslip_print/{{val['slip_id']}}" class="btn btn-primary mt-3 mb-3 fa fa-download"> Download</a>
                                       <br/>
                                       <button class="btn btn-primary mail_btn oi oi-unarchive"> Request For Mail</button>
                                   </div>
                                     <div class="bg-light p-2">
                                         <h4><span class="">&#36; <t t-esc="total_value"/></span>  </h4>
                                   </div>



                               </div>

                                     </t>
                               <div class="o_portal" style="width:900px; margin-left:50px;">
                                   <table class="table" style="border:1px solid; width:900px; ">
                                       <tr>
                                           <th style="border:1px solid;">Name</th>
                                           <th style="border:1px solid;">Code</th>
                                           <th style="border:1px solid;">Category</th>
                                           <th style="border:1px solid;">Amount</th>
                                       </tr>
                                       <t t-foreach="salary_lines"   t-as="line" t-key="line_id">
                                       <tr>
                                           <td style="border:1px solid;"><t t-esc="line['c_name']"/></td>
                                           <td style="border:1px solid;"><t t-esc="line['code']"/></td>
                                           <td style="border:1px solid;"><t t-esc="line['category']"/></td>
                                           <td style="border:1px solid;"><t t-esc="line['amount']"/></td>
                                       </tr>
                                        </t>
                                   </table>
                               </div>
                           </div>
                       </div>
                   </div>
               </div>
           </t>
    </template>
</odoo>