<odoo>

        <template id="payslips_details_template" name="page">
           <t t-call="portal.portal_layout">
                <t t-set="is_portal" t-value="True"/>
               <div id="wrap" class="o_portal_wrap">
                   <div class="container">
                       <div class="row">
                           <div class="col-12 text-center mt-5 o_portal">
                                <h1 class="card-text text-primary">Payslip</h1>
                                <t t-foreach="vals" t-as="val" t-key="val_id">
                               <div class="d-flex mt-5 o_portal details_div">

                                        <div class="" style="margin-left:250px; margin-top:15px; margin-bottom:30px;">
                                             <h5  style="">Name: <t class="sequence_number" t-esc="val['number']"/></h5>
                                        <h5 style="margin-left:45px;">Employee: <t t-esc="val['employee']"/></h5>
                                        <h5 style="">Record: <t t-esc="val['emp_record']"/></h5>
                                        </div>
                                        <div class="" style="margin-left:100px; margin-top:15px; margin-bottom:30px;">
                                            <h5 style="margin-left:25px;">From: <t t-esc="val['from']"/></h5>
                                        <h5>To: <t t-esc="val['to']"/></h5>
                                        <h5 style="margin-right:30px;">Wage: <t t-esc="val['wage']"/></h5>
                                        </div>
                                   <div class="mt-3 " style="margin-left:100px;">
                                        <a t-attf-href="/payslip_print/{{val['slip_id']}}" class="btn btn-primary ml-2 fa fa-download"> Download</a>
                                       <button class="btn btn-primary mail_btn oi oi-unarchive"> Request For Mail</button>
                                   </div>

                               </div>

                                     </t>
                               <div class="o_portal">
                                   <table class="table" style="border:1px solid;">
                                       <tr>
                                           <th style="border:1px solid;">Name</th>
                                           <th style="border:1px solid;">Code</th>
                                           <th style="border:1px solid;">Category</th>
                                           <th style="border:1px solid;">Amount</th>
                                       </tr>
                                       <t t-foreach="salary_lines"   t-as="line" t-key="line_id">
                                       <tr>
                                           <td style="border:1px solid;"><t t-esc="line['c_name']"/></td>
                                           <td style="border:1px solid;"><t t-esc="line['code']"/></td>
                                           <td style="border:1px solid;"><t t-esc="line['category']"/></td>
                                           <td style="border:1px solid;"><t t-esc="line['amount']"/></td>
                                       </tr>
                                        </t>
                                   </table>
                               </div>
                                    <h4 style="margin-left:1030px;"><t t-esc="total_value"/> </h4>
                           </div>
                       </div>
                   </div>
               </div>
           </t>
    </template>
</odoo>