<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_purchase_order" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='purchase']" position="inside">
                <field name="company_id" invisible="1"/>
            </xpath>
            <xpath expr="//setting[@id='po_order_approval']" position="after">
                       <setting id="attachment_for_po" company_dependent="1"  help="Mandatory Attachment Before Confirming Purchase Order">
                           <field name="mandatory_attachment_for_po"/>
                       </setting>
            </xpath>
        </field>
    </record>
</odoo>