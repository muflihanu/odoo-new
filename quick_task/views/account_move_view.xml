<odoo>
    <record id="account_moves_view_form" model="ir.ui.view">
        <field name="name">account.moves.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <group>
                    <field name="related_so" widget="many2many_tags" domain="[('id','in',partner_related_so),('invoice_status','in','to invoice')]"/>
                    <field name="partner_related_so" invisible="1"/>
                </group>

            </xpath>
        </field>
    </record>
</odoo>