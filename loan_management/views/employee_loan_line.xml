<odoo>
     <record id="employee_loan_line_action" model="ir.actions.act_window">
        <field name="name">employee loan line</field>
        <field name="res_model">employee.loan.line</field>
        <field name="view_mode">list,form</field>
    </record>


    <record id="employee_loan_line_view" model="ir.ui.view">
        <field name="name">employee loan line view</field>
        <field name="model">employee.loan.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                             <field name="loan_id"/>
                             <field name="date"/>
                             <field name="paid"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>