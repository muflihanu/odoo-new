<odoo>
    <record id="employee_loan_action" model="ir.actions.act_window">
        <field name="name">employee loan</field>
        <field name="res_model">employee.loan</field>
        <field name="view_mode">list,form</field>
    </record>


    <record id="employee_loan_view" model="ir.ui.view">
        <field name="name">employee loan view</field>
        <field name="model">employee.loan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button type="object" name="action_approve" string="confirm" invisible=" state in ('approved','paid')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                 <div class="button_box" position="inside">
                        <button type="object" class="oe_start_button" icon="oi-subtitle" name="get_employee_loan_line">
                                <field name="total_line_count"/>
                        </button>
                    </div>
                <sheet>

                    <group>
                        <group>
                             <field name="name"/>
                             <field name="employee_id"/>
                             <field name="loan_amount"/>
                        </group>
                        <group>
                            <field name="installment_count"/>
                            <field name="start_date"/>
                            <field name="installment_amount"/>
                            <field name="total_payable"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>