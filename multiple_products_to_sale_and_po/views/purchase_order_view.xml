<odoo>
    <record id="purchase_orders_view_form" model="ir.ui.view">
        <field name="name">purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
         <field name="arch" type="xml">
           <xpath expr="//button[@name='action_add_from_catalog']" position="after">
               <button class="btn text-primary" string="Add multiple product" name="add_product"  type="object" context="{'order_id':parent.id}"/>

           </xpath>
        </field>
    </record>
</odoo>