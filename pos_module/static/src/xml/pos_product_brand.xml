<?xml version="1.0" encoding="UTF-8"?>
<templates id="product_brand_template" xml:space="preserve">
    <t t-name="pos_sale.Orderline" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//ul[hasclass('info-list')]" position="inside">
            <t t-if="line.product_id.brand_id">
                 Brand: <t t-esc="line.product_id.brand_id.raw.name"/>

            </t>
        </xpath>
    </t>
</templates>
