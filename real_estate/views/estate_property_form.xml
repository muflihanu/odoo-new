<odoo>
    <record id="estate_property_form" model="ir.ui.view">
        <field name="name">estate_property_for</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="view_form">
                <group>
                     <group>
                    <button type="object" string="sold" name="sold_property"  invisible="state in('sold','cancelled')" />
                    <button type="object" string="Cancel"   name="cancel_property"   invisible="state in('sold','cancelled')" />

                </group>
                <div>
                         <button type="object" string="Action" icon="fa-cog"   />
                    </div>


                </group>
                <field name="state"  widget="statusbar"/>
                <sheet>
                    <group>
<!--                        <group>-->
                           <h1><field name="name" placeholder="Name"/></h1>
                             <field name="tag" widget="many2many_tags" options="{'color_field': 'color'}" />
<!--                        </group>-->
                        <newline/>
                        <group>

                            <field name="property__type"  options="{'no_create': true, 'no_edit': true}"/>
                            <field name="postcode"/>
                            <field name="date_availability"/>

                        </group>
                        <group>
                           <field name="expected_price"/>
                            <field name="best_price"/>
                            <field name="selling_price"/>
                        </group>
                        <notebook>
                            <page string="Description" sequance="1">
                                <group>
                                    <field name="property_description"/>
                                    <field name="bedrooms"/>
                                    <field name="living_area"/>
                                    <field name="facades"/>
                                    <field name="garage"/>
                                     <field name="garden"/>
                                     <field name="garden_area"  invisible='not garden' />
                                     <field name="garden_oreantation"  invisible='not garden' />
                                    <field name="state"/>
                                    <field name="active"/>
                                    <field name="total_area"/>

                                </group>
                            </page>

                             <page string="Offer" sequance="2">
                                <field name="offer" readonly="state in ('sold','cancelled','offer received')"/>
                            </page>
                            <page string="Other Info" sequance="3">
                                <group>
                                    <field name="buyer"/>
                                    <field name="seller"/>
                                </group>
                            </page>


                        </notebook>
                    </group>

                </sheet>
            </form>
        </field>
    </record>


    <record id="property_offer_form_action" model="ir.ui.view">
        <field name="name">property_offer_form</field>
        <field name="model">property.offer</field>
        <field name="arch" type="xml">
            <form string="property_type">
                <group>
                 <field name="offer_price"/>
                 <field name="partner_id"/>
                    <field name="validity"/>
                    <field name="date_deadline"/>
                 <field name="status"/>
                </group>
            </form>
        </field>
    </record>

    <record id="property_type_form" model="ir.ui.view">
        <field name="name">property type</field>
        <field name="model">property.type</field>
        <field name="arch" type="xml">
            <form string="type from">
                <sheet>
                    <group>
                        <field name="property_type"/>
                        <field name="offer_count"/>
                    </group>
                    <notebook>
                        <page string="Properties">
                            <group>

                        <field name="property_id">
                            <list>
                                <field name="name"/>
                                 <field name="expected_price"/>
                                 <field name="state"/>
                            </list>
                        </field>

                            </group>
                        </page>
                    </notebook>

                </sheet>

            </form>
        </field>
    </record>
</odoo>