<odoo>
<record id="res_config_settings_form_view" model="ir.ui.view">
        <field name="name">res.config.settings.form.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
                 <xpath expr="//block[@id='pos_inventory_section']" position="inside">
                     <setting id="discount limit">
                         <field name="discount_limit"/>
                     </setting>

                 </xpath>
        </field>
    </record>
</odoo>

