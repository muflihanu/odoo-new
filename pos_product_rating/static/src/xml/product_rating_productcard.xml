<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_product_rating.ProductCard" t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-img')]" position="after">
            <t t-if="this.props.product.rating">
                 Rating: <t t-esc="this.props.product.rating"/>
                    <div class="d-flex" >
                         <t t-foreach="Array.from({length:this.props.product.rating})" t-as="k" t-key="k_index">
                         <i class="fa fa-star" style="color:#DAA520;"/>
                         </t>
                    </div>
            </t>


        </xpath>
    </t>
</templates>