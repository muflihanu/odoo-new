<odoo>
    order food
    <record id="order_food_reception_rule" model="ir.rule">
        <field name="name">Reception rule for order food</field>
        <field name="model_id" ref="model_order_food"/>
        <field name="groups" eval="[(4, ref('group_reception'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>


      <record id="order_food_manager_rule" model="ir.rule">
        <field name="name">manager rule for order food</field>
        <field name="model_id" ref="model_order_food"/>
        <field name="groups" eval="[(4, ref('group_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

