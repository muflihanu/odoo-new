<odoo>

    <record id="hotel_rooms_action" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">hotel.rooms</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_available':1}</field>
    </record>


    <record id="hotel_rooms_view_form" model="ir.ui.view">
        <field name="name">Rooms</field>
        <field name="model">hotel.rooms</field>
        <field name="arch" type="xml">
            <form string="rooms form">
                <field name="state" widget="statusbar"/>
                <sheet>
                    <group>
                         <group>
                        <field name="room_no"/>
                        <field name="bed"/>
                        <field name="available_beds"/>
                    </group>
                        <group>
                             <field name="room_image" widget="image" options="{'size':[130,130]}"/>
                        </group>
                    <group>
                         <field name="state" />
                        <field name="rent"/>
                        <field name="facility_id"/>
                    </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


     <record id="hotel_rooms_view_list" model="ir.ui.view">
        <field name="name">Rooms_view</field>
        <field name="model">hotel.rooms</field>
        <field name="arch" type="xml">
            <list string="rooms view">
                <field name="room_no"/>
                <field name="bed"/>
                <field name="available_beds"/>
                 <field name="facility_id"/>
                <field name="rent"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="hotel_rooms_view_search" model="ir.ui.view">
        <field name="name">Rooms_search</field>
        <field name="model">hotel.rooms</field>
        <field name="arch" type="xml">
            <search string="rooms search">
                <filter string="available" name="available" domain="[('state','=','available')]"/>
                <filter name="bed"  string="Type" context="{'group_by':'bed'}"/>
            </search>
        </field>
    </record>
</odoo>