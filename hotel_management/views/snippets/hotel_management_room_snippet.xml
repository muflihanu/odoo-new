<odoo>

     <template id="hotel_management_room_template" name="hotel management room snippet">
       <section class="room_section">
           <div class="container">
               <div class="col-12 text-center mt-5 ">
                   <h1>AVAILABLE ROOMS</h1>
               </div>
           </div>
       </section>
   </template>
   <template id="hotel_management_room_snippet" inherit_id="website.snippets"
             name="Hotel Management Room Snippet">
       <xpath expr="//snippets[@id='snippet_content']" position="inside">
           <t t-snippet="hotel_management.hotel_management_room_template"
              t-thumbnail="/hotel_management/static/src/images/room.jpg"/>
       </xpath>
       <xpath expr="//snippets[@id='snippet_structure']" position="inside">
           <t t-snippet="hotel_management.hotel_management_room_template"/>
       </xpath>
   </template>
</odoo>