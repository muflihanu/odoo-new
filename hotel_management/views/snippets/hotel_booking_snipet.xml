<odoo>
     <template id="hotel_booking_template_highlight" name="Hotel Room Booking Form">
                <section class=" hotel_room_booking_section container py-5">
                    <div class="row justify-content-center">
                        <div class="col-md-6 col-lg-5">
                            <div class="card shadow rounded-3 border-0">
                                <div class="card-body p-4">
                                    <h3 class="mb-4 text-center">Room Booking</h3>
                                    <form  style="margin-top: 20px;" class="booking_form">

                                         <div class="form-group">
                                    <label class='sel1'>Guest:</label>
                                  <select  id="partner_id" name="partner_id" class="form-control">
                                       <t t-foreach="request.env['res.partner'].sudo().search([])" t-as="partner">
                                       <option t-att-value="partner.id"><t t-esc="partner.name"/></option>
                                       </t>
                                 </select>
                                    <p id="partner_error" class="text-danger"></p>
                                 </div>

                                         <div class="mb-3">
                                            <label class="form-label">count:</label>
                                            <input type="number" name="count" class="count form-control" value="0"/>
                                        </div>

                                        <div id="output" style="padding:20px;background: #dadada;"></div>
                                        <div class="form-group">
                                    <label class='sel1'>Other Guests:</label>
                                  <select   id="p_ids" name="p_ids"   class="p_ids form-control"  multiple="multiple"  style="height:30px!important; border:1px solid!important; border-radius:3px!important;">
                                       <t t-foreach="request.env['res.partner'].sudo().search([])" t-as="p">
                                       <option t-att-value="p.id"><t t-esc="p.name"/></option>
                                       </t>
                                 </select>
                                    <p id="other_guest_error" class="text-danger"></p>
                                 </div>

                                        <div class="mb-3">
                                            <label class="form-label">Check In:</label>
                                            <input type="date" name="check_in"  class="check_in form-control" />
                                            <p id="check_in_error" class="text-danger"></p>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Expected Days:</label>
                                            <input type="number" name="expected_days" class="expected_days form-control"/>
                                             <p id="expected_error" class="text-danger"></p>

                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Attachement:</label>
                                            <input type="file" name="attach_id" class="attach_id form-control"/>
                                             <p id="attach_error" class="text-danger"></p>

                                        </div>
                                        <div class="form-group">
                                    <label class='sel1'>Room Type:</label>
                                  <select name="room type" class="form-control" >
                                       <option value="single">Single</option>
                                       <option value="double">Double</option>
                                       <option value="dormitory">Dormitory</option>
                                 </select>
                                 </div>
                                        <div class="d-grid mt-5">
                                            <button  id="btn_submit" class="btn btn-primary">Book Now</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
        </template>



           <template id="room_booking_success_template" name="booking success">
           <t t-call="website.layout">
               <div id="wrap" class="oe_structure">
                   <div class="container">
                       <div class="row">
                           <div class="col-12 text-center mt-5">
                                <h3>Booking  Successfully Completed!</h3>
                                <div class="col-12 text-center mt-5 " style="background-image: url('/hotel_management/static/src/images/success.webp'); height: 700px; width: 100%;"/>
                           </div>
                       </div>
                   </div>
               </div>
           </t>

       </template>

   <template id="hotel_booking_highlight_snippet" inherit_id="website.snippets"
             name="Hotel Accommodation Booking Highlight Snippet">
       <xpath expr="//snippets[@id='snippet_content']" position="inside">
           <t t-snippet="hotel_management.hotel_booking_template_highlight"/>
<!--              t-thumbnail="/hotel_management/static/src/images/hotel.jpeg"/>-->
       </xpath>
       <xpath expr="//snippets[@id='snippet_structure']" position="inside">
           <t t-snippet="hotel_management.hotel_booking_template_highlight"/>
       </xpath>
   </template>
</odoo>