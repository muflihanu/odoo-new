<odoo>
    <record id="hotel_gallery_action" model="ir.actions.act_window">
        <field name="name">Gallery Images</field>
        <field name="res_model">hotel.gallery</field>
        <field name="view_mode">list,form</field>
    </record>


     <record id="hotel_gallary_view_form" model="ir.ui.view">
        <field name="name">hotel_gallery_view</field>
        <field name="model">hotel.gallery</field>
        <field name="arch" type="xml">
            <form string="hotel gallery form">
                <sheet>
                    <group>
                         <field name="gallery_images" widget="image" options="{'size': [500, 500]}"/>
                    </group>
                </sheet>

            </form>
        </field>
    </record>

     <record id="hotel_gallary_view_list" model="ir.ui.view">
        <field name="name">hotel_gallery_view</field>
        <field name="model">hotel.gallery</field>
        <field name="arch" type="xml">
            <list string="hotel gallery list">
                <field name="gallery_images"/>
            </list>
        </field>
    </record>
</odoo>