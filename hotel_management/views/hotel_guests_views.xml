<?xml version="1.0" encoding="utf-8"?>
<odoo>

 <record id="guests_action" model="ir.actions.act_window">
        <field name="name">Hotel Guests</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
    </record>

<data>
 <record id="hotel_guests_view_form" model="ir.ui.view">
        <field name="name">res.users.view.form.inherit.gamification</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
                 <xpath expr="//field[@name='category_id']" position="after">
                     <field name="hotel_guests"/>
                 </xpath>
        </field>
    </record>
    </data>
</odoo>