<odoo>
    <record id="order_food_action" model="ir.actions.act_window">
        <field name="name">Oder Food</field>
        <field name="res_model">order.food</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="order_food_view_form" model="ir.ui.view">
        <field name="name">order food </field>
        <field name="model">order.food</field>
        <field name="arch" type="xml">
            <form string="order_food_form">
                <group>
                    <button type="object" name="confirm_order" string="confirm"  class="oe_highlight" invisible="state in ('confirm')" />
                </group>
                <field name="state" widget="statusbar"/>
                <sheet>
                    <group>
                        <h1><field name="order_reference_number" readonly="1" /> </h1>
                      <group>
                        <field name="accommodation_id" domain="[('state','in',('check-in'))]" />
                        <field name="accommodation_guest"/>
                       </group>
                       <group>
                        <field name="accommodation_room"/>
                        <field name="order_time"/>
                        </group>
                        <notebook>
                            <page name="Menu">
                                <group>
                                <field name="food_related_category_ids" widget="many2many_tags"/>
                                    <field name="food_items_menus_ids" context="{'default_order':id}" readonly="1">
                                         <kanban create="1" edit="0" class="o_kanban_mobile">
                                        <templates >
                                        <t t-name="card" class="flex-row">
                                         <aside class="o_kanban_aside_full d-none d-md-block">
                                          <field name="image" widget="image" />
                                         </aside>
                                         <main>
                                          <div class="d-flex">
                                           <field name="food_name" class="fw-bold fs-5" />
                                          </div>
                                          <div>
                                           <field name="category_id"/>
                                          </div>
                                          <footer class="pt-0 mt-0">
                                           <field name="food_price"  class="fw-bold ms-auto"/>
                                         </footer>
                                       </main>
                                      </t>
                                 </templates>
                               </kanban>
                                    </field>
                                </group>

                            </page>
                              <page name="Order List">
                                   <field name="order_list_ids" readonly="1" >
                                       <list>
                                           <field name="order_name"/>
                                           <field name="order_description"/>
                                           <field name="quantity"/>
                                           <field name="unit_price"/>
                                           <field name="subtotal"/>5
                                       </list>
                                   </field>
                                  <group class="float-end">
                                       <field name="total_price"/>
                                  </group>
                              </page>
                        </notebook>
                     </group>
                </sheet>
            </form>
        </field>
    </record>


       <record id="orderfood_view_list" model="ir.ui.view">
                            <field name="name">food_order_list</field>
                            <field name="model">order.food</field>
                            <field name="arch" type="xml">
                                <list>
                                    <field name="order_reference_number"/>
                                    <field name="accommodation_id"/>
                                </list>
                            </field>
                        </record>
</odoo>