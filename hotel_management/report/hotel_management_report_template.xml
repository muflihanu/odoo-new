<odoo>
     <template id="hotel_management_report">
       <t t-call="web.html_container">
           <t t-foreach="docs" t-as="o">
               <t t-call="web.external_layout">
                   <div class="page">
                       <div class="oe_structure"/>
                       <h2>Hotel Management Report</h2>
                       <br/>
                       <h4>Date from</h4>
                       <h4>Date to</h4>
                       <h4>Guest :<span t-field="o.room_id"/></h4>
                       <br/>
                       <br/>
                       <table class="table">
                           <tr>
                               <th>SL.No</th>
                               <th>Guest</th>
                               <th>Check-In</th>
                               <th>Check-Out</th>
                               <th>State</th>
                           </tr>
                       </table>

                   </div>
               </t>
           </t>
       </t>
   </template>
</odoo>