<odoo>
     <template id="hotel_management_report">
       <t t-call="web.html_container">
               <t t-call="web.external_layout">
                   <div class="page">
                       <div class="oe_structure"/>
                       <h2>Hotel Management Report</h2>
                       <br/>
                       <h4>Date from: <t t-out="date['from_date']"/> </h4>
                       <h4>Date to:<t t-esc="date['to_date']"/></h4>
                      <div>
                           <h4  t-if="date['guest']==False">Guest:</h4>
                            <h4 t-else=""> Guest:<t t-esc="date['guest'][1]"/></h4>
                      </div>


                       <br/>
                       <br/>
                       <table  class="table">
                          <thead>
                           <tr>
                               <th>SL.No</th>
                               <th>Guest</th>
                               <th>Check-In</th>
                               <th>Check-Out</th>
                               <th>State</th>
                           </tr>
                            </thead>
                         <t t-foreach="report" t-as="re">
                             <tbody>
                           <tr>
                               <td><t t-esc="re['reference_number']"/></td>
                               <td><t t-esc="re['name']"/></td>
                               <td><t t-esc="re['check_in']"/></td>
                               <td><t t-esc="re['check_out']"/></td>
                               <td><t t-esc="re['state']"/></td>
                           </tr>
                             </tbody>
                           </t>
                       </table>

                   </div>
               </t>
           </t>
   </template>
</odoo>