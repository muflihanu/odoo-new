<odoo>
      <record id="cron_scheduled_check_out_mail" model="ir.cron">
            <field name="name">today check-out mail</field>
            <field name="model_id" ref="model_hotel_accommodation"/>
            <field name="state">code</field>
            <field name="code">model.action_send_mail()</field>
             <field name="interval_number">1</field>
            <field name="interval_type">days</field>
           <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now() + timedelta(minutes=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
</odoo>