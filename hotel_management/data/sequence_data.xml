<odoo>
    <data noupdate="1">

        <record id="accomadation_sequence_number" model="ir.sequence">
         <field name="name">accommodation sequence number</field>
         <field name="code">hotel.accommodation_code</field>
         <field name="prefix">HM/ROOM/</field>
         <field name="padding">4</field>
         <field name="number_next">1</field>
       </record>

        <record id="order_food_sequence_number" model="ir.sequence">
         <field name="name">order food sequence number</field>
         <field name="code">order.reference</field>
         <field name="prefix">HM/FOOD/</field>
         <field name="padding">4</field>
         <field name="number_next">1</field>
     </record>
    </data>
</odoo>