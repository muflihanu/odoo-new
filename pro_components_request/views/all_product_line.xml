<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="all_product_line_action" model="ir.actions.act_window">
        <field name="name">all_product.line</field>
        <field name="res_model">all.product.line</field>
        <field name="view_mode">list,form</field>
    </record>


     <record id="all_product_line_view_form" model="ir.ui.view">
        <field name="name">all.product.line.form</field>
        <field name="model">all.product.line</field>
        <field name="arch" type="xml">
            <form string="all product line form" >
                <header>
                    <field name="state" widget="statusbar" invisible="1" />

                </header>
                <sheet>
                    <group>
                         <group>
                             <field name="product_id"/>
                             <field name="quantity" invisible="1"/>
                              <field name="product_uom_ids" invisible="1"/>
                              <field name="unit_of_measure"  invisible="1"/>
                             <field name="pro_type"/>
                             <field name="vendor"/>
                               <field name="source_location_id"/>
                                        <field name="destination_location_id"/>
                         </group>

                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>