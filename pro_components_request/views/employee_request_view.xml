<odoo>
    <record id="employee_request_action" model="ir.actions.act_window">
        <field name="name">Employee Request</field>
        <field name="res_model">employee.request</field>
        <field name="view_mode">list,form</field>
    </record>


     <record id="employee_request_view_form" model="ir.ui.view">
        <field name="name">employee.request.form</field>
        <field name="model">employee.request</field>
        <field name="arch" type="xml">
            <form string="employee request form" >
                <header>
                    <field name="state" widget="statusbar"/>
                    <button type="object" name="send_request" string="Send Request" invisible="state in ('confirm','first approve','second approve')"  groups="pro_components_request.group_request_user"/>
                    <button type="object" name="first_approve" string="Approve" invisible="state in ('draft','first approve','second approve')"  groups="pro_components_request.group_hr"/>
                    <button type="object" name="second_approve" string="Approve" invisible="state in ('draft','confirm','second approve')" groups="pro_components_request.group_manager" />
                </header>
                <sheet>
                    <group>
                          <h1> <field name="request_sequence"/></h1>
                         <newline/>
                         <group>
                             <field name="employee_id"/>
                         </group>
                        <notebook>

                               <page name="Product Line">
                                <field name="all_product_line_ids">
                                    <list editable="bottom">
                                        <field name="product_id"/>
                                        <field name="quantity"/>
                                        <field name="pro_type"/>
                                        <field name="vendor"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>

                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="employee_request_view_list" model="ir.ui.view">
        <field name="name">employee.request.list</field>
        <field name="model">employee.request</field>
        <field name="arch" type="xml">
            <list>
                 <field name="request_sequence"/>
                <field name="employee_id"/>

            </list>
        </field>
    </record>
</odoo>